# Optional: deterministic replay, storage, BM25 search and statistics work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
POKER_DB=.local/poker.db
# Set to openai to enable paid semantic indexing/query embedding, otherwise bm25.
POKER_RETRIEVAL=bm25
